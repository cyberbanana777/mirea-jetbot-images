# Репозиторий и коммит, который клонируется при сборке образа.
# Переопределить коммит разово: ./build_image.sh <хеш>
REPO_URL=https://github.com/cyberbanana777/mirea_jetbot_full
REPO_COMMIT=5c048a1

# Реестр, откуда build_image.sh скачает базовый образ, если локального нет (или задай REGISTRY в окружении)
# REGISTRY=registry.local:5000

# Параллельные задачи сборки (на arm64 с малой памятью оставь 2 или 1)
BUILD_JOBS=2

# Рантайм контейнера: runc или nvidia (на Jetson с nvidia-рантаймом)
# DOCKER_RUNTIME=runc
